<?php

/**
 * @file
 * Hook implementations for the Field Label Override module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\field_label_override\Hook\FieldLabelOverrideHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function field_label_override_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(FieldLabelOverrideHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_form_FORM_ID_alter() for entity_view_display_edit_form.
 */
#[LegacyHook]
function field_label_override_form_entity_view_display_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(FieldLabelOverrideHooks::class)->formEntityViewDisplayEditFormAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_preprocess_field().
 */
#[LegacyHook]
function field_label_override_preprocess_field(&$variables, $hook) {
  \Drupal::service(FieldLabelOverrideHooks::class)->preprocessField($variables, $hook);
}
